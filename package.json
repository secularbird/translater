{
  "name": "sonora-translate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "models:setup": "python3 scripts/prepare_sherpa.py && node scripts/prepare_assets.mjs",
    "models:download": "python3 scripts/download_models.py",
    "predev": "node scripts/prepare_assets.mjs",
    "prebuild": "node scripts/prepare_assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "python3 tests/run_tests.py --suite browser",
    "test:android": "python3 tests/run_tests.py --suite android",
    "test:all": "python3 tests/run_tests.py",
    "test:report": "python3 tests/report_results.py",
    "test:offline": "python3 tests/run_tests.py --suite offline",
    "test:vad": "python3 tests/run_tests.py --suite vad",
    "test:resources:android": "python3 tests/resource_android.py",
    "test:layout:android": "python3 tests/layout_android.py",
    "test:offline:android": "python3 tests/offline_android.py",
    "test:offline:desktop": "python3 tests/offline_desktop.py",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "android": "tauri android dev",
    "ios": "tauri ios dev"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@noble/hashes": "1.8.0",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinyld": "1.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
